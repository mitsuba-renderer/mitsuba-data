<!--
    Backend comparison for rotation interpolation.

    A single instance rotates 150 degrees about the vertical axis between two
    keyframes. By default the shutter is *closed* (shutter_open ==
    shutter_close), so this renders one instantaneous pose rather than a blur:
    what differs between the backends is where that pose lies. Setting the
    shutter to [0, 1] instead shows what those differences do to a real
    motion-blurred render.

      Embree  slerp  -> the reference, -40.5 deg at t = 0.23
      OptiX   nlerp  -> same path, non-constant rate: -45.0 deg (4.5 off)
      Metal   nlerp  -> same path, non-constant rate: -45.0 deg (matching OptiX)

    Render the same file under llvm_ad_rgb, cuda_ad_rgb and metal_ad_rgb.
-->
<scene version="3.0.0">
    <path value="../../common"/>

    <!-- Defaults render the instantaneous pose. Override both with 0 and 1 to
         get the motion-blurred version of the same comparison. -->
    <default name="shutter_open"  value="0.23"/>
    <default name="shutter_close" value="0.23"/>
    <default name="spp"           value="1024"/>

    <bsdf type="twosided" id="object_bsdf">
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.2, 0.25, 0.7"/>
        </bsdf>
    </bsdf>

    <shape type="shapegroup" id="teapot_group">
        <shape type="ply">
            <string name="filename" value="meshes/teapot.ply"/>
            <transform name="to_world">
                <!-- Recentre on the rotation axis, then scale to fill the frame -->
                <translate x="-0.215" y="0" z="0"/>
                <scale value="0.42"/>
            </transform>
            <ref id="object_bsdf"/>
        </shape>
    </shape>

    <shape type="instance">
        <ref id="teapot_group"/>
        <animation name="to_world">
            <transform time="0">
                <rotate z="1" angle="-75"/>
            </transform>
            <transform time="1">
                <rotate z="1" angle="75"/>
            </transform>
        </animation>
    </shape>

    <sensor type="perspective">
        <string name="fov_axis" value="smaller"/>
        <float name="fov" value="28.8415"/>
        <float name="focus_distance" value="6.0"/>

        <!-- Closed shutter: a single instant, not a blur.

             t = 0.23 is chosen deliberately. Slerp and nlerp agree exactly at
             t = 0, 0.5 and 1 (the normalised average *is* the great-circle
             midpoint), and differ most near t = 0.23 and t = 0.77. At t = 0.5
             the OptiX image would be pixel-identical to the Embree one. -->
        <float name="shutter_open" value="$shutter_open"/>
        <float name="shutter_close" value="$shutter_close"/>

        <transform name="to_world">
            <lookat target="3.04072, -2.85176, 2.80939"
                    origin="3.69558, -3.46243, 3.25463"
                    up="-0.317366, 0.312466, 0.895346"/>
        </transform>

        <sampler type="independent">
            <integer name="sample_count" value="$spp"/>
        </sampler>

        <film type="hdrfilm">
            <integer name="width" value="720"/>
            <integer name="height" value="720"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <include filename="include/animation_scene.xml"/>
</scene>
