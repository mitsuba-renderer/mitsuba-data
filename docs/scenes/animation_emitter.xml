<!--
    Motion blur from an animated emitter.

    The geometry and the camera are static; only the spot light swings across
    the bunny. The environment map is dimmed so the moving light dominates.
-->
<scene version="3.0.0">
    <path value="../../common"/>

    <!-- Overrides the include's default of 3 -->
    <default name="envmap_scale" value="0.12"/>

    <bsdf type="twosided" id="object_bsdf">
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.55, 0.55, 0.6"/>
        </bsdf>
    </bsdf>

    <shape type="ply">
        <string name="filename" value="meshes/bunny.ply"/>
        <transform name="to_world">
            <scale value="12"/>
            <rotate z="1" angle="130"/>
            <rotate y="1" angle="70"/>
            <rotate x="1" angle="-50"/>
            <rotate z="1" angle="-50"/>
            <rotate y="1" angle="-2"/>
            <rotate x="1" angle="12"/>
            <translate x="0.3" y="0" z="-0.3"/>
        </transform>
        <ref id="object_bsdf"/>
    </shape>

    <!-- Travels in an arc around the bunny while staying aimed at it. Moving
         the light's *position* (not just its aim) is what smears the shadow:
         a spot that only pivots leaves its shadow stationary. -->
    <emitter type="spot">
        <rgb name="intensity" value="55"/>
        <!-- beam_width just under cutoff_angle gives a hard-edged beam, so the
             lit footprint sweeping across the scene is unmistakable. They must
             not be exactly equal: the falloff divides by their difference. -->
        <float name="cutoff_angle" value="26"/>
        <float name="beam_width" value="25.5"/>
        <animation name="to_world">
            <transform time="0">
                <lookat target="0.3, 0.0, 0.6" origin="-3.7, -2.1, 3.6" up="0, 0, 1"/>
            </transform>
            <transform time="1">
                <lookat target="0.3, 0.0, 0.6" origin="-0.9, -4.4, 3.6" up="0, 0, 1"/>
            </transform>
        </animation>
    </emitter>

    <sensor type="perspective">
        <string name="fov_axis" value="smaller"/>
        <float name="fov" value="28.8415"/>
        <float name="focus_distance" value="6.0"/>

        <float name="shutter_open" value="0"/>
        <float name="shutter_close" value="1"/>

        <transform name="to_world">
            <lookat target="3.04072, -2.85176, 2.80939"
                    origin="3.69558, -3.46243, 3.25463"
                    up="-0.317366, 0.312466, 0.895346"/>
        </transform>

        <sampler type="independent">
            <integer name="sample_count" value="512"/>
        </sampler>

        <film type="hdrfilm">
            <integer name="width" value="960"/>
            <integer name="height" value="720"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <include filename="include/animation_scene.xml"/>
</scene>
