<!--
    Motion blur from an animated sensor (camera motion blur).

    Nothing in the scene moves: the camera does. A sensor interpolates its
    'to_world' at the time of each ray, so the whole frame smears.
-->
<scene version="3.0.0">
    <path value="../../common"/>

    <bsdf type="twosided" id="object_bsdf">
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.2, 0.25, 0.7"/>
        </bsdf>
    </bsdf>

    <shape type="ply">
        <string name="filename" value="meshes/bunny.ply"/>
        <transform name="to_world">
            <scale value="12"/>
            <rotate z="1" angle="130"/>
            <rotate y="1" angle="70"/>
            <rotate x="1" angle="-50"/>
            <rotate z="1" angle="-50"/>
            <rotate y="1" angle="-2"/>
            <rotate x="1" angle="12"/>
            <translate x="0.3" y="0" z="-0.3"/>
        </transform>
        <ref id="object_bsdf"/>
    </shape>

    <sensor type="perspective">
        <string name="fov_axis" value="smaller"/>
        <float name="fov" value="28.8415"/>
        <float name="focus_distance" value="6.0"/>

        <float name="shutter_open" value="0"/>
        <float name="shutter_close" value="1"/>

        <!-- The camera dollies sideways. Origin and target move together, so this
             is a pure translation: pointing a fixed target would swing the
             camera instead, since the target sits only ~1 unit away. -->
        <animation name="to_world">
            <transform time="0">
                <lookat target="2.98612, -2.91026, 2.80939"
                        origin="3.64098, -3.52093, 3.25463"
                        up="-0.317366, 0.312466, 0.895346"/>
            </transform>
            <transform time="1">
                <lookat target="3.09532, -2.79326, 2.80939"
                        origin="3.75018, -3.40393, 3.25463"
                        up="-0.317366, 0.312466, 0.895346"/>
            </transform>
        </animation>

        <sampler type="independent">
            <integer name="sample_count" value="256"/>
        </sampler>

        <film type="hdrfilm">
            <integer name="width" value="960"/>
            <integer name="height" value="720"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <include filename="include/animation_scene.xml"/>
</scene>
